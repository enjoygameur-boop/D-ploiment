/* rr_exp.c - Fast scan: hold the loot reveal duration at zero.
}
    elog("hits=%d r=%d", g_nhit, r);
/* rr_exp.c - Fast scan: hold the loot reveal duration at zero.

   The reveal delay is the backing field TimeToOneCellBorder at +0x58 of every
   InventoryRevealViewDescriptions instance. The game rewrites the value, so it
   must be held while enabled and restored when disabled.

   The class is resolved once by name and cached. Resolution runs on the worker
   thread, never on the render thread. */

#include <windows.h>
#include <stdint.h>
#include <stdio.h>
#include <string.h>
#include <stdarg.h>
#include "rr_mem.h"
#include "menu_bridge.h"
#include "rr_exp.h"

#define EXP_OFF      0x58
#define EXP_MAX_INST 32
#define EXP_WRITE_MS 5
#define EXP_LOG 1
#define EXP_LOG 1

static const char EXP_NAME[] = "InventoryRevealViewDescriptions";
#define EXP_NAMELEN ((unsigned)sizeof(EXP_NAME) - 1u)

static volatile LONG g_started, g_enabled, g_ready;
static DWORD g_arm;
static uint64_t g_klass, g_klass_tmp;
static uint64_t g_hit[64];
static int g_nhit;
static uint64_t g_inst[EXP_MAX_INST];
static float    g_orig[EXP_MAX_INST];
static int      g_ninst;
static int      g_dom_done;
static int      g_write_regions;
static uint64_t g_cur;
static int      g_budget;
static uint64_t g_type_begin, g_type_end;

static int name_ok(uint64_t cand);
static int hold(void);

static void elog(const char* fmt, ...) {
#if !EXP_LOG
    return;
#endif
#if !EXP_LOG
    return;
#endif
    char path[MAX_PATH], buf[512];
    FILE* f;
    va_list ap;
    if (!GetTempPathA(MAX_PATH, path)) return;
    strcat(path, "rr_exp.log");
    f = fopen(path, "a");
    if (!f) return;
    va_start(ap, fmt);
    vsnprintf(buf, sizeof buf, fmt, ap);
    va_end(ap);
    fprintf(f, "%lu %s\n", GetTickCount(), buf);
    fclose(f);
}

static int read_str(uint64_t a, char* out, int cap) {
    if (!a || cap < 2) return 0;
    out[0] = 0;
    if (!rr_read(a, out, (size_t)cap - 1)) return 0;
    out[cap - 1] = 0;
    return out[0] != 0;
}

static int p_raw(uint64_t v) {
    return v >= 0x10000ull && v < 0x00007FFFFFFFFFFFull;
}

static int p_qw(uint64_t v) {
    return p_raw(v) && ((v & 7ull) == 0);
}

static int ascii_ok(const char* s) {
    int i = 0;
    if (!s || !s[0]) return 0;
    for (; s[i] && i < 95; i++) {
        unsigned char c = (unsigned char)s[i];
        if (c < 32 || c > 126) return 0;
    }
    return i >= 3;
}

static int pe_export_find(uint64_t mod, const char* want, uint64_t* out) {
    uint8_t dos[0x40];
    int32_t e_lfanew = 0;
    uint32_t sig = 0;
    uint16_t optsz = 0;
    uint64_t nt, opt;
    uint8_t oph[0x90];
    uint16_t magic = 0;
    uint32_t dd_off = 0;
    uint32_t exp_rva = 0, exp_sz = 0;
    uint8_t ed[40];
    uint32_t nfunc = 0, nname = 0, fn_rva = 0, nm_rva = 0, ord_rva = 0;
    uint32_t i;

    if (out) *out = 0;
    if (!p_qw(mod) || !want || !out) return 0;
    if (!rr_read(mod, dos, sizeof dos)) return 0;
    memcpy(&e_lfanew, dos + 0x3C, 4);
    if (e_lfanew <= 0 || e_lfanew > 0x1000) return 0;
    nt = mod + (uint64_t)e_lfanew;
    if (!rr_read(nt, &sig, 4) || sig != 0x00004550u) return 0;
    if (!rr_read(nt + 0x14, &optsz, 2) || optsz < 0x70) return 0;
    opt = nt + 24;
    if (!rr_read(opt, oph, sizeof oph)) return 0;
    memcpy(&magic, oph + 0, 2);
    dd_off = (magic == 0x20Bu) ? 0x70u : (magic == 0x10Bu ? 0x60u : 0u);
    if (!dd_off || dd_off + 8 > sizeof oph) return 0;
    memcpy(&exp_rva, oph + dd_off + 0, 4);
    memcpy(&exp_sz,  oph + dd_off + 4, 4);
    if (!exp_rva || exp_sz < 40) return 0;
    if (!rr_read(mod + exp_rva, ed, sizeof ed)) return 0;
    memcpy(&nfunc,   ed + 20, 4);
    memcpy(&nname,   ed + 24, 4);
    memcpy(&fn_rva,  ed + 28, 4);
    memcpy(&nm_rva,  ed + 32, 4);
    memcpy(&ord_rva, ed + 36, 4);
    if (!nfunc || !nname || !fn_rva || !nm_rva || !ord_rva) return 0;

    for (i = 0; i < nname; i++) {
        uint32_t r_name = 0, r_fn = 0;
        uint16_t ord = 0;
        char name[96];
        if (!rr_read(mod + nm_rva + (uint64_t)i * 4, &r_name, 4) || !r_name) continue;
        if (!read_str(mod + r_name, name, sizeof name)) continue;
        if (strcmp(name, want)) continue;
        if (!rr_read(mod + ord_rva + (uint64_t)i * 2, &ord, 2)) return 0;
        if ((uint32_t)ord >= nfunc) return 0;
        if (!rr_read(mod + fn_rva + (uint64_t)ord * 4, &r_fn, 4) || !r_fn) return 0;
        if (r_fn >= exp_rva && r_fn < exp_rva + exp_sz) return 0; /* forwarded export */
        *out = mod + r_fn;
        return 1;
    }
    return 0;
}

static int rip_targets(uint64_t fn, uint64_t* out, int max) {
    uint8_t code[160];
    int i, n = 0;
    if (!out || max <= 0) return 0;
    if (!rr_read(fn, code, sizeof code)) return 0;
    for (i = 0; i + 7 <= (int)sizeof code; i++) {
        uint8_t b0 = code[i + 0], b1 = code[i + 1], b2 = code[i + 2];
        if ((b0 == 0x48 || b0 == 0x4C) && (b1 == 0x8B || b1 == 0x8D) && ((b2 & 0xC7u) == 0x05u)) {
            int32_t rel = 0;
            uint64_t t;
            int k;
            memcpy(&rel, code + i + 3, 4);
            t = fn + (uint64_t)i + 7 + (int64_t)rel;
            if (!p_raw(t)) continue;
            for (k = 0; k < n; k++) if (out[k] == t) break;
            if (k == n && n < max) out[n++] = t;
        }
    }
    return n;
}

static int domain_like(uint64_t d) {
    static const uint32_t off[] = { 0x08, 0x10, 0x18, 0x20, 0x28 };
    int i;
    if (!p_qw(d)) return 0;
    for (i = 0; i < (int)(sizeof off / sizeof off[0]); i++) {
        uint64_t sp = rr_u64(d + off[i]);
        char s[64];
        if (!p_raw(sp)) continue;
        if (read_str(sp, s, sizeof s) && ascii_ok(s)) return 1;
    }
    return 0;
}

static uint64_t image_from_asm(uint64_t ap) {
    static const uint32_t off[] = { 0x00, 0x08, 0x10, 0x18, 0x20, 0x28 };
    int i;
    for (i = 0; i < (int)(sizeof off / sizeof off[0]); i++) {
        uint64_t img = rr_u64(ap + off[i]);
        uint64_t n0, n1;
        char s[80];
        if (!p_qw(img)) continue;
        n0 = rr_u64(img + 0x00);
        n1 = rr_u64(img + 0x08);
        if (p_raw(n0) && read_str(n0, s, sizeof s) && ascii_ok(s)) return img;
        if (p_raw(n1) && read_str(n1, s, sizeof s) && ascii_ok(s)) return img;
    }
    return 0;
}

static int asm_vec_from(uint64_t vec, uint64_t* arr, uint32_t* cnt) {
    uint64_t p0, p1, p2, first;
    if (arr) *arr = 0;
    if (cnt) *cnt = 0;
    if (!p_raw(vec) || !arr || !cnt) return 0;

    p0 = rr_u64(vec + 0x00);
    p1 = rr_u64(vec + 0x08);
    p2 = rr_u64(vec + 0x10);

    if (p_qw(p0) && p_qw(p1) && p1 >= p0) {
        uint64_t bytes = p1 - p0;
        uint32_t n = (uint32_t)(bytes / 8ull);
        if (bytes && !(bytes & 7ull) && n > 0 && n <= 4096 && bytes <= 0x20000ull) {
            if (rr_read(p0, &first, 8) && p_qw(first) && image_from_asm(first)) {
                *arr = p0;
                *cnt = n;
                return 1;
            }
        }
    }

    if (p_qw(p0) && p1 > 0 && p1 <= 4096 && p2 >= p1) {
        uint32_t n = (uint32_t)p1;
        if (rr_read(p0, &first, 8) && p_qw(first) && image_from_asm(first)) {
            *arr = p0;
            *cnt = n;
            return 1;
        }
    }

    return 0;
}

static void asm_dump48(uint64_t addr, int jumped, const uint8_t* bytes) {
    char hex[48 * 3 + 1];
    int i;
    for (i = 0; i < 48; i++) snprintf(hex + i * 3, 4, "%02X ", bytes[i]);
    hex[48 * 3 - 1] = 0;
    if (jumped) elog("domain: asm jump bytes@%llx=%s", (unsigned long long)addr, hex);
    else elog("domain: fn_asm=%llx bytes=%s", (unsigned long long)addr, hex);
}

static void asm_body_patterns(const uint8_t* b) {
    static const char* regname[16] = {
        "rax", "rcx", "rdx", "rbx", "rsp", "rbp", "rsi", "rdi",
        "r8", "r9", "r10", "r11", "r12", "r13", "r14", "r15"
    };
    int i;
    int first_load = -1, last_load = -1, first_store = -1, count_load = -1;
    int first_disp = 0, last_disp = 0, count_disp = 0;

    for (i = 0; i + 3 <= 48; i++) {
        if (b[i] == 0x48 && b[i + 1] == 0x8B &&
            ((b[i + 2] >> 3) & 7) == 0 &&
            ((b[i + 2] & 7) == 1 || (b[i + 2] & 7) == 3)) {
            int mod = b[i + 2] >> 6;
            int disp = 0, ok = 0;
            int base = b[i + 2] & 7;
            if (mod == 0) {
                ok = 1;
            } else if (mod == 1 && i + 4 <= 48) {
                int8_t d8 = 0;
                memcpy(&d8, b + i + 3, 1);
                disp = d8;
                ok = 1;
            } else if (mod == 2 && i + 7 <= 48) {
                int32_t d32 = 0;
                memcpy(&d32, b + i + 3, 4);
                disp = d32;
                ok = 1;
            }
            if (!ok) continue;
            elog("domain: asm load at=%02X base=%s disp=%X",
                 i, base == 1 ? "rcx" : "rbx", (unsigned)disp);
            if (first_load < 0) { first_load = i; first_disp = disp; }
            last_load = i;
            last_disp = disp;
        }

        if ((b[i] == 0x48 || b[i] == 0x4C) && b[i + 1] == 0x89 &&
            (b[i + 2] >> 6) == 0 && (b[i + 2] & 7) == 3) {
            int reg = ((b[i + 2] >> 3) & 7) + (b[i] == 0x4C ? 8 : 0);
            elog("domain: asm count store at=%02X reg=%s", i, regname[reg]);
            if (first_store < 0) { first_store = i; count_load = last_load; count_disp = last_disp; }
        }
    }

    if (first_load >= 0) elog("domain: asm array offset=%X", (unsigned)first_disp);
    if (count_load >= 0 && count_load != first_load)
        elog("domain: asm count offset=%X", (unsigned)count_disp);
    if (first_store >= 0) elog("domain: asm count store offset=%X", first_store);
}

static void asm_call_dump48(uint64_t addr, const uint8_t* bytes) {
    char hex[48 * 3 + 1];
    int i;
    for (i = 0; i < 48; i++) snprintf(hex + i * 3, 4, "%02X ", bytes[i]);
    hex[48 * 3 - 1] = 0;
    elog("domain: asm call bytes@%llx=%s", (unsigned long long)addr, hex);
}

static void asm_struct_dump(const char* kind, uint32_t idx, uint64_t addr, uint32_t size) {
    uint8_t buf[0x60];
    uint32_t off;
    if (size > sizeof buf) return;
    if (!rr_read(addr, buf, size)) {
        elog("domain: vector %s[%u]@%llx unavailable",
             kind, idx, (unsigned long long)addr);
        return;
    }
    for (off = 0; off < size; off += 16) {
        char hex[16 * 3 + 1];
        uint32_t n = size - off;
        uint32_t j;
        if (n > 16) n = 16;
        for (j = 0; j < n; j++) snprintf(hex + j * 3, 4, "%02X ", buf[off + j]);
        hex[n * 3 - 1] = 0;
        elog("domain: vector %s[%u]@%llx+%02X=%s",
             kind, idx, (unsigned long long)addr, off, hex);
    }
}

static int klass_type_valid(uint64_t klass) {
    uint64_t np = 0;
    uint8_t c = 0;
    if (!p_qw(klass)) return 0;
    if (!rr_read(klass + 0x10, &np, 8) || !p_raw(np)) return 0;
    return rr_read(np, &c, 1) && c >= 32 && c <= 126;
}

static void asm_vector_probe(uint64_t target) {
    uint8_t raw[16];
    uint64_t begin = 0, end = 0, count = 0;
    uint32_t i, lim;

    elog("EXP_NAME=%s", EXP_NAME);
    if (!rr_read(target, raw, sizeof raw)) {
        elog("domain: vector unavailable@%llx", (unsigned long long)target);
        return;
    }
    memcpy(&begin, raw, 8);
    memcpy(&end, raw + 8, 8);
    if (end >= begin) count = (end - begin) / 8;
    elog("domain: vector target=%llx begin=%llx end=%llx count=%llu",
         (unsigned long long)target, (unsigned long long)begin,
         (unsigned long long)end, (unsigned long long)count);
    if (count < 1 || count > 400) {
        elog("domain: vector count rejected");
        return;
    }

    lim = (uint32_t)count;
    for (i = 0; i < lim; i++) {
        uint64_t ptr = 0, q0 = 0, name = 0;
        char s[65], nm[64];
        int have_name = 0, match = 0;
        s[0] = 0;
        memset(nm, 0, sizeof nm);
        if (!rr_read(begin + (uint64_t)i * 8, &ptr, 8)) {
            elog("domain: vector elem[%u] ptr=0 image=0 name=0 str=\"<unreadable>\"", i);
            continue;
        }
        if (p_raw(ptr)) rr_read(ptr, &q0, 8);
        if (i == 0 || i == 100) {
            asm_struct_dump("assembly", i, ptr, 0x48);
            asm_struct_dump("image", i, q0, 0x40);
        }
        if (p_raw(q0) && rr_read(q0, &name, 8) && p_raw(name)) {
            if (rr_read(name, nm, 17) &&
                strncmp(nm, "Assembly-CSharp", 15) == 0 && nm[15] == '.') {
                match = 1;
            }
            if (read_str(name, s, 65) && ascii_ok(s)) have_name = 1;
        }
        if (!have_name) strcpy(s, "<unreadable>");
        elog("domain: vector elem[%u] ptr=%llx image=%llx name=%llx str=\"%s\"",
             i, (unsigned long long)ptr, (unsigned long long)q0,
             (unsigned long long)name, s);
        if (!match) continue;

        {
            uint64_t type_count, nlog = 0;
            uint32_t b32 = 0, e32 = 0;
            g_type_begin = 0;
            g_type_end = 0;
            rr_read(q0 + 0x18, &b32, 4);
            rr_read(q0 + 0x20, &e32, 4);
            g_type_begin = b32;
            g_type_end = e32;
            elog("TYPES image=%p begin=%p end=%p",
                 (void*)(uintptr_t)q0, (void*)(uintptr_t)g_type_begin,
                 (void*)(uintptr_t)g_type_end);
            if (g_type_end <= g_type_begin || !g_type_begin) {
                elog("TYPES vide");
                continue;
            }
            type_count = (uint64_t)(e32 - b32);
            if (type_count == 0 || type_count > 200000) {
                elog("TYPES count=%llu rejete", (unsigned long long)type_count);
                continue;
            }
            elog("TYPES count=%llu", (unsigned long long)type_count);

            {
                static const uint64_t cand_off[] = { 0x28, 0x30 };
                int ci;
                asm_struct_dump("image", 130, q0, 0x60);
                for (ci = 0; ci < 2; ci++) {
                    uint64_t arrp = 0, j, lim2;
                    if (!rr_read(q0 + cand_off[ci], &arrp, 8) || !p_qw(arrp)) {
                        elog("ARR[%llx] unreadable", (unsigned long long)cand_off[ci]);
                        continue;
                    }
                    lim2 = type_count > 25 ? 25 : type_count;
                    elog("ARR[%llx] ptr=%llx n=%llu", (unsigned long long)cand_off[ci],
                         (unsigned long long)arrp, (unsigned long long)type_count);
                    for (j = 0; j < lim2; j++) {
                        uint64_t k = 0, np2 = 0;
                        char nm2[48];
                        if (!rr_read(arrp + j * 8, &k, 8) || !p_qw(k)) {
                            elog("ARR[%llx][%llu] k=0", (unsigned long long)cand_off[ci], (unsigned long long)j);
                            continue;
                        }
                        if (!rr_read(k + 0x10, &np2, 8) || !p_raw(np2)) {
                            elog("ARR[%llx][%llu] k=%llx np=0", (unsigned long long)cand_off[ci],
                                 (unsigned long long)j, (unsigned long long)k);
                            continue;
                        }
                        memset(nm2, 0, sizeof nm2);
                        if (!read_str(np2, nm2, sizeof nm2)) strcpy(nm2, "<bad>");
                        elog("ARR[%llx][%llu] k=%llx nom=%s", (unsigned long long)cand_off[ci],
                             (unsigned long long)j, (unsigned long long)k, nm2);
                    }
                }
            }

            g_cur = g_type_begin;
            g_budget = 0;
            for (;;) {
                uint64_t klass = 0, np = 0;
                char tn[64];
                int kv;
                if (g_cur >= g_type_end) { g_cur = 0; break; }
                if (g_budget <= 0) g_budget = 40000;
                g_budget--;
                if (!rr_read(g_cur, &klass, 8)) { g_cur += 8; continue; }
                g_cur += 8;
                kv = klass_type_valid(klass);
                if (!rr_read(klass + 0x10, &np, 8) || !p_raw(np)) continue;
                memset(tn, 0, sizeof tn);
                if (read_str(np, tn, sizeof tn) && ascii_ok(tn)) {
                    if (nlog < 20) {
                        if (kv) {
                            elog("TYPE[%llu] klass=%p nom=%s",
                                 nlog, (void*)(uintptr_t)klass, tn);
                        } else {
                            elog("TYPE rejete[%llu] klass=%p nom=%s",
                                 nlog, (void*)(uintptr_t)klass, tn);
                        }
                        nlog++;
                    }
                } else {
                    continue;
                }
                if (!kv) continue;
                if (strcmp(tn, EXP_NAME)) continue;
                elog("KLASS %p nom=%s", (void*)(uintptr_t)klass, tn);
                g_klass = klass;
                hold();
                g_cur = 0;
                return;
            }
        }
    }
}

static void asm_call_target_dump(uint64_t fn_asm, const uint8_t* body) {
    uint8_t bytes[48];
    int32_t rel = 0;
    uint64_t target;
    uint32_t first_rip = 0, first_add = 0;
    int rip_seen = 0, add_seen = 0;
    int i;

    if (body[0x09] != 0xE8) {
        elog("domain: asm call missing");
        return;
    }
    memcpy(&rel, body + 0x0A, 4);
    target = fn_asm + 0x0Full + (int64_t)rel;
    elog("domain: asm call target=%llx rel=%X",
         (unsigned long long)target, (unsigned)rel);
    if (!rr_read(target, bytes, sizeof bytes)) {
        elog("domain: asm call bytes unavailable@%llx", (unsigned long long)target);
        return;
    }
    asm_call_dump48(target, bytes);

    for (i = 0; i + 3 <= 48; i++) {
        if (bytes[i] == 0x48 && bytes[i + 1] == 0x8B && bytes[i + 2] == 0x05 &&
            i + 7 <= 48) {
            int32_t disp = 0;
            memcpy(&disp, bytes + i + 3, 4);
            elog("domain: asm domain rip at=%02X disp=%X", i, (unsigned)disp);
            if (!rip_seen) { rip_seen = 1; first_rip = (uint32_t)disp; }
        }
        if (bytes[i] == 0x48 && bytes[i + 1] == 0x83 && bytes[i + 2] == 0xC0 &&
            i + 4 <= 48) {
            int8_t imm = 0;
            memcpy(&imm, bytes + i + 3, 1);
            elog("domain: asm vector add at=%02X offset=%X", i, (unsigned)(int)imm);
            if (!add_seen) { add_seen = 1; first_add = (uint32_t)(int32_t)imm; }
        }
        if (bytes[i] == 0x48 && bytes[i + 1] == 0x81 && bytes[i + 2] == 0xC0 &&
            i + 7 <= 48) {
            int32_t imm = 0;
            memcpy(&imm, bytes + i + 3, 4);
            elog("domain: asm vector add at=%02X offset=%X", i, (unsigned)imm);
            if (!add_seen) { add_seen = 1; first_add = (uint32_t)imm; }
        }
        if (bytes[i] == 0x48 && bytes[i + 1] == 0x05 && i + 6 <= 48) {
            int32_t imm = 0;
            memcpy(&imm, bytes + i + 2, 4);
            elog("domain: asm vector add at=%02X offset=%X", i, (unsigned)imm);
            if (!add_seen) { add_seen = 1; first_add = (uint32_t)imm; }
        }
    }
    if (rip_seen && add_seen)
        elog("domain: asm call offsets rip=%X vector=%X", first_rip, first_add);
    if (bytes[0] == 0x8D && bytes[1] == 0x05) {
        int32_t disp = 0;
        memcpy(&disp, bytes + 2, 4);
        asm_vector_probe(target + 6ull + (int64_t)disp);
    } else {
        elog("domain: vector lea missing");
    }
}

static void asm_export_dump(uint64_t fn_asm) {
    uint64_t cur = fn_asm;
    int jumps = 0;

    for (;;) {
        uint8_t bytes[48];
        uint64_t target;

        if (!rr_read(cur, bytes, sizeof bytes)) {
            elog("domain: asm bytes unavailable@%llx", (unsigned long long)cur);
            return;
        }
        asm_dump48(cur, jumps != 0, bytes);

        if (bytes[0] != 0xE9 && bytes[0] != 0xEB) {
            elog("domain: asm body=%llx", (unsigned long long)cur);
            asm_body_patterns(bytes);
            asm_call_target_dump(fn_asm, bytes);
            return;
        }
        if (jumps >= 8) {
            elog("domain: asm jump limit=%llx", (unsigned long long)cur);
            return;
        }

        if (bytes[0] == 0xE9) {
            int32_t rel = 0;
            memcpy(&rel, bytes + 1, 4);
            target = cur + 5ull + (int64_t)rel;
        } else {
            int8_t rel = 0;
            memcpy(&rel, bytes + 1, 1);
            target = cur + 2ull + (int64_t)rel;
        }
        jumps++;
        elog("domain: asm jump[%d] op=%02X src=%llx dst=%llx",
             jumps, bytes[0], (unsigned long long)cur,
             (unsigned long long)target);
        cur = target;
    }
}

static void domain_structure_dump(uint64_t domain) {
    uint8_t dump[0x100];
    uint32_t off;

    if (!rr_read(domain, dump, sizeof dump)) {
        elog("domain: dump unavailable");
        return;
    }

    for (off = 0; off < 0x100; off += 0x10) {
        const uint8_t* p = dump + off;
        elog("domain: dump[%02X]=%02X %02X %02X %02X %02X %02X %02X %02X %02X %02X %02X %02X %02X %02X %02X %02X",
             off, p[0], p[1], p[2], p[3], p[4], p[5], p[6], p[7],
             p[8], p[9], p[10], p[11], p[12], p[13], p[14], p[15]);
    }

    for (off = 0; off + 8 <= 0x100; off += 8) {
        uint64_t ptr = 0, q0 = 0, q1 = 0;
        uint64_t elem[3] = { 0, 0, 0 };
        uint64_t eq0[3] = { 0, 0, 0 };
        uint64_t eq1[3] = { 0, 0, 0 };
        uint8_t b10 = 0, eb10[3] = { 0, 0, 0 };
        int er[3] = { 0, 0, 0 }, ebr[3] = { 0, 0, 0 };
        int valid = 0, j;
        int br;

        memcpy(&ptr, dump + off, 8);
        if (!p_qw(ptr)) continue;
        rr_read(ptr, &q0, 8);
        rr_read(ptr + 8, &q1, 8);
        br = rr_read(ptr + 0x10, &b10, 1);
        elog("domain: cand[%02X] ptr=%llx q0=%llx q1=%llx b10=%02X br=%d",
             off, (unsigned long long)ptr, (unsigned long long)q0,
             (unsigned long long)q1, b10, br);

        for (j = 0; j < 3; j++) {
            if (rr_read(ptr + (uint64_t)j * 8, &elem[j], 8) && p_qw(elem[j]) &&
                rr_read(elem[j], &eq0[j], 8) && rr_read(elem[j] + 8, &eq1[j], 8)) {
                er[j] = 1;
                valid++;
                ebr[j] = rr_read(elem[j] + 0x10, &eb10[j], 1);
            }
        }
        if (valid < 2) continue;

        elog("domain: table[%02X] ptr=%llx valid=%d elem=%llx %llx %llx",
             off, (unsigned long long)ptr, valid,
             (unsigned long long)elem[0], (unsigned long long)elem[1],
             (unsigned long long)elem[2]);
        for (j = 0; j < 3; j++) {
            uint64_t img;
            elog("domain: table[%02X] elem[%d]=%llx q0=%llx q1=%llx b10=%02X br=%d ok=%d",
                 off, j, (unsigned long long)elem[j],
                 (unsigned long long)eq0[j], (unsigned long long)eq1[j],
                 eb10[j], ebr[j], er[j]);
            if (!er[j]) continue;
            img = image_from_asm(elem[j]);
            if (img) {
                uint8_t ib10 = 0;
                int ibr = rr_read(img + 0x10, &ib10, 1);
                elog("domain: table[%02X] image[%d]=%llx b10=%02X br=%d",
                     off, j, (unsigned long long)img, ib10, ibr);
            }
        }
    }
}

static uint64_t domain_from_export(uint64_t fn_dom) {
    uint8_t code[160];
    uint64_t cur = fn_dom;
    int jumps = 0;

    for (;;) {
        int i;

        if (!rr_read(cur, code, sizeof code)) {
            elog("domain: unresolved");
            return 0;
        }

        if (code[0] == 0xE9 || code[0] == 0xEB) {
            uint64_t target;
            uint8_t bytes[16];

            if (jumps >= 8) {
                elog("domain: unresolved");
                return 0;
            }
            if (code[0] == 0xE9) {
                int32_t rel = 0;
                memcpy(&rel, code + 1, 4);
                target = cur + 5ull + (int64_t)rel;
            } else {
                int8_t rel = 0;
                memcpy(&rel, code + 1, 1);
                target = cur + 2ull + (int64_t)rel;
            }

            jumps++;
            elog("domain: jump[%d] op=%02X src=%llx dst=%llx",
                 jumps, code[0], (unsigned long long)cur,
                 (unsigned long long)target);
            cur = target;
            if (rr_read(cur, bytes, sizeof bytes)) {
                elog("domain: jump bytes@%llx=%02X %02X %02X %02X %02X %02X %02X %02X %02X %02X %02X %02X %02X %02X %02X %02X",
                     (unsigned long long)cur,
                     bytes[0], bytes[1], bytes[2], bytes[3],
                     bytes[4], bytes[5], bytes[6], bytes[7],
                     bytes[8], bytes[9], bytes[10], bytes[11],
                     bytes[12], bytes[13], bytes[14], bytes[15]);
            } else {
                elog("domain: jump bytes@%llx unavailable", (unsigned long long)cur);
            }
            continue;
        }

        /* Skip the known prologue forms, then scan for a RIP-relative load. */
        i = 0;
        for (;;) {
            if (i + 5 <= (int)sizeof code &&
                code[i] == 0x48 && code[i + 1] == 0x89 &&
                code[i + 2] == 0x5C && code[i + 3] == 0x24) {
                i += 5;
                continue;
            }
            if (i + 4 <= (int)sizeof code &&
                code[i] == 0x48 && code[i + 1] == 0x83 && code[i + 2] == 0xEC) {
                i += 4;
                continue;
            }
            if (i + 2 <= (int)sizeof code && code[i] == 0x40 && code[i + 1] == 0x53) {
                i += 2;
                continue;
            }
            break;
        }

        for (; i + 7 <= (int)sizeof code; i++) {
            int32_t rel = 0;
            uint64_t target, value;
            int match =
                (code[i] == 0x48 && code[i + 1] == 0x8B &&
                 (code[i + 2] == 0x05 || code[i + 2] == 0x0D)) ||
                (code[i] == 0x48 && code[i + 1] == 0x8D && code[i + 2] == 0x05) ||
                (code[i] == 0x4C && code[i + 1] == 0x8B && code[i + 2] == 0x05);
            if (!match) continue;

            memcpy(&rel, code + i + 3, 4);
            target = cur + (uint64_t)i + 7ull + (int64_t)rel;
            elog("domain: export opcode=%02X %02X %02X target=%llx",
                 code[i], code[i + 1], code[i + 2], (unsigned long long)target);
            if (!p_raw(target)) continue;
            value = rr_u64(target);
            if (!p_qw(value)) continue;
            elog("domain: export ptr=%llx", (unsigned long long)value);
            return value;
        }

        elog("domain: unresolved");
        return 0;
    }
}

static int klass_like(uint64_t k, uint64_t image) {
    uint64_t img, np;
    char c = 0;
    if (!p_qw(k)) return 0;
    img = rr_u64(k + 0x00);
    if (img != image) return 0;
    np = rr_u64(k + 0x10);
    if (!p_raw(np)) return 0;
    if (!rr_read(np, &c, 1)) return 0;
    return c >= 32 && c <= 126;
}

static int klass_from_image(uint64_t image, uint64_t* out) {
    static const uint32_t ptr_off[] = {
        0x20, 0x28, 0x30, 0x38, 0x40, 0x48, 0x50, 0x58,
        0x60, 0x68, 0x70, 0x78, 0x80, 0x88, 0x90
    };
    static const uint32_t cnt_off[] = {
        0x18, 0x1C, 0x20, 0x24, 0x28, 0x2C, 0x30, 0x34,
        0x38, 0x3C, 0x40, 0x44
    };
    int p, c;
    if (out) *out = 0;
    if (!p_qw(image) || !out) return 0;

    for (p = 0; p < (int)(sizeof ptr_off / sizeof ptr_off[0]); p++) {
        uint64_t arr = rr_u64(image + ptr_off[p]);
        if (!p_qw(arr)) continue;
        for (c = 0; c < (int)(sizeof cnt_off / sizeof cnt_off[0]); c++) {
            uint32_t n = rr_u32(image + cnt_off[c]);
            uint32_t i, lim, probe;
            int strong = 0;
            if (n == 0 || n > 60000) continue;

            probe = n < 32 ? n : 32;
            for (i = 0; i < probe; i++) {
                uint64_t k = rr_u64(arr + (uint64_t)i * 8);
                if (!p_qw(k)) continue;
                if (klass_like(k, image)) strong++;
                if (name_ok(k)) {
                    *out = k;
                    elog("domain image hit off=%X cnt=%X idx=%u", ptr_off[p], cnt_off[c], i);
                    return 1;
                }
            }
            if (strong < 2) continue;
            lim = n > 32768 ? 32768 : n;
            for (i = probe; i < lim; i++) {
                uint64_t k = rr_u64(arr + (uint64_t)i * 8);
                if (!p_qw(k)) continue;
                if (!klass_like(k, image)) continue;
                if (name_ok(k)) {
                    *out = k;
                    elog("domain image hit off=%X cnt=%X idx=%u", ptr_off[p], cnt_off[c], i);
                    return 1;
                }
            }
        }
    }
    return 0;
}

static int resolve_domain_klass(void) {
    uint64_t mod = 0, fn_dom = 0, fn_asm = 0;
    uint64_t domain = 0, arr = 0, k = 0;
    uint32_t mod_sz = 0, n = 0;
    uint32_t i;

    if (!rr_module("GameAssembly.dll", &mod, &mod_sz) || !mod) {
        elog("domain: GameAssembly missing");
        return 0;
    }
    if (!pe_export_find(mod, "il2cpp_domain_get", &fn_dom) || !fn_dom) {
        elog("domain: il2cpp_domain_get missing");
        return 0;
    }
    {
        uint8_t fn_bytes[16];
        if (rr_read(fn_dom, fn_bytes, sizeof fn_bytes)) {
            elog("domain: fn_dom=%llx bytes=%02X %02X %02X %02X %02X %02X %02X %02X %02X %02X %02X %02X %02X %02X %02X %02X",
                 (unsigned long long)fn_dom,
                 fn_bytes[0], fn_bytes[1], fn_bytes[2], fn_bytes[3],
                 fn_bytes[4], fn_bytes[5], fn_bytes[6], fn_bytes[7],
                 fn_bytes[8], fn_bytes[9], fn_bytes[10], fn_bytes[11],
                 fn_bytes[12], fn_bytes[13], fn_bytes[14], fn_bytes[15]);
        } else {
            elog("domain: fn_dom=%llx bytes unavailable", (unsigned long long)fn_dom);
        }
    }
    domain = domain_from_export(fn_dom);
    if (!domain) {
        elog("domain: pointer unavailable");
        return 0;
    }

    if (!pe_export_find(mod, "il2cpp_domain_get_assemblies", &fn_asm) || !fn_asm) {
        elog("domain: il2cpp_domain_get_assemblies missing");
        return 0;
    }
    asm_export_dump(fn_asm);
    if (g_klass) {
        g_klass_tmp = g_klass;
        return 1;
    }


    domain_structure_dump(domain);
    for (i = 0; i + 0x18 <= 0x100; i += 8) {
        if (asm_vec_from(domain + i, &arr, &n)) break;
    }
    if (!arr || !n) {
        elog("domain: assemblies vector unavailable");
        return 0;
    }

    elog("domain ok=%llx asms=%u arr=%llx", (unsigned long long)domain, n, (unsigned long long)arr);
    for (i = 0; i < n && i < 4096; i++) {
        uint64_t ap = rr_u64(arr + (uint64_t)i * 8);
        uint64_t img;
        if (!p_qw(ap)) continue;
        img = image_from_asm(ap);
        if (!img) continue;
        if (klass_from_image(img, &k) && k) {
            g_klass_tmp = k;
            elog("domain klass=%llx asm[%u]=%llx img=%llx",
                 (unsigned long long)k, i,
                 (unsigned long long)ap, (unsigned long long)img);
            return 1;
        }
    }
    elog("domain: class not found in assemblies");
    return 0;
}

typedef int (*WALK_FN)(uint64_t, const uint8_t*, unsigned);
static int      g_stage;
static long     g_okr;

static int walk(int priv, int mapped, int image, WALK_FN fn) {
    enum { CHUNK = 0x1000 };
    static uint8_t pool[CHUNK];
    const uint64_t limit = 0x7FFFFFFEFFFFull;
    uint64_t addr = g_cur ? g_cur : 0x10000;
    RR_REGION rg;

    while (addr < limit) {
        uint64_t start, end, scan_end, q;
        if (!rr_query_region(addr, &rg) || !rg.size) { addr += 0x10000; continue; }
        start = rg.base < 0x10000 ? 0x10000 : rg.base;
        end = rg.base + rg.size;
        scan_end = end;
        if (scan_end > start + 0x4000000ull) scan_end = start + 0x4000000ull;
        if (rg.state == 0x1000 && (rg.protect & 0xFF) && !(rg.protect & 0x100) &&
            (!g_write_regions || (rg.protect & 0xCC)) &&
            ((rg.type == 0x20000 && priv) || (rg.type == 0x40000 && mapped) ||
             (rg.type == 0x1000000 && image))) {
            for (q = start; q < scan_end; q += CHUNK) {
                unsigned sz = (unsigned)((scan_end - q) < CHUNK ? (scan_end - q) : CHUNK);
                if (g_budget <= 0) { g_cur = q; return -1; }
                g_budget--;
                memset(pool, 0, sz);
                if (rr_read(q, pool, sz)) { g_okr++; if (fn(q, pool, sz)) return 1; }
                if (!(g_budget & 7)) Sleep(1);
            }
        }
        addr = (end > addr) ? end : addr + 0x10000;
    }
    g_cur = 0;
    return 0;
}

static int walk_writable(WALK_FN fn) {
    int r;
    g_write_regions = 1;
    r = walk(1, 0, 0, fn);
    g_write_regions = 0;
    return r;
}

static int cb_lit(uint64_t base, const uint8_t* p, unsigned len) {
    unsigned o;
    if (len < EXP_NAMELEN) return 0;
    for (o = 0; o + EXP_NAMELEN < len; o++) {
        if (p[o] != (uint8_t)EXP_NAME[0]) continue;
        if (memcmp(p + o, EXP_NAME, EXP_NAMELEN)) continue;
        if (p[o + EXP_NAMELEN]) continue;
        elog("STR %llx", (unsigned long long)(base + o));
        if (g_nhit < 8) g_hit[g_nhit++] = base + o;
        if (g_nhit >= 8) return 1;
    }
    return 0;
}

static int cb_klass_string(uint64_t base, const uint8_t* p, unsigned len) {
    unsigned o;
    if (len < EXP_NAMELEN) return 0;
    for (o = 0; o + EXP_NAMELEN < len; o++) {
        uint64_t s, back;
        if (p[o] != (uint8_t)EXP_NAME[0]) continue;
        if (memcmp(p + o, EXP_NAME, EXP_NAMELEN)) continue;
        if (p[o + EXP_NAMELEN]) continue;
        s = base + o;
        if (s < 0x10) continue;
        back = 0;
        if (!rr_read(s - 0x10, &back, 8) || back != s) continue;
        g_klass = s - 0x10;
        g_klass_tmp = g_klass;
        elog("KLASS %llx", (unsigned long long)g_klass);
        return 1;
    }
    return 0;
}

static int cb_ptr(uint64_t base, const uint8_t* p, unsigned len) {
    char nm[48];
    unsigned o;
    int i;
    for (o = 0; o + 8 <= len; o += 8) {
        uint64_t v;
        memcpy(&v, p + o, 8);
        for (i = 0; i < g_nhit; i++) {
            uint64_t cand, nsp;
            uint8_t t;
            if (v != g_hit[i] || base + o < 0x10) continue;
            cand = base + o - 0x10;
            if (!rr_read(cand + 0x18, &nsp, 8)) continue;
            if (nsp && !rr_read(nsp, &t, 1)) continue;
            { char dbg[17]; if (!rr_read(cand + 0x10, dbg, 16)) { elog("cand %llx unreadable", (unsigned long long)cand); continue; } dbg[16] = 0; elog("cand %llx [%s]", (unsigned long long)cand, dbg); }
            if (!name_ok(cand)) continue;
            g_klass_tmp = cand;
            return 1;
        }
    }
    return 0;
}

static int cb_inst(uint64_t base, const uint8_t* p, unsigned len) {
    unsigned o;
    for (o = 0; o + 8 <= len; o += 8) {
        uint64_t v;
        float f;
        memcpy(&v, p + o, 8);
        if (v != g_klass) continue;
        if (!rr_read(base + o + EXP_OFF, &f, 4)) continue;
        if (!(f > 0.0f && f < 60.0f)) continue;
        if (g_ninst < EXP_MAX_INST) {
            g_inst[g_ninst] = base + o;
            g_orig[g_ninst] = f;
            elog("INST %llx val=%f", (unsigned long long)(base + o), (double)f);
            g_ninst++;
        }
        if (g_ninst >= EXP_MAX_INST) return 1;
    }
    return 0;
}

static int name_ok(uint64_t cand) {
    uint64_t np = 0;
    char s[16];
    if (!rr_read(cand + 0x10, &np, 8) || !np) { elog("no np c=%llx", (unsigned long long)cand); return 0; }
    if (!rr_read(np, s, sizeof s)) { elog("no str np=%llx", (unsigned long long)np); return 0; }
    { int m = memcmp(s, EXP_NAME, sizeof s); elog("nok c=%llx m=%d", (unsigned long long)cand, m); return m == 0; }
}

/* ---- patch get/set TimeToOneCellBorder par RVA ---- */

#define EXP_GET_RVA  0x843A30ull
#define EXP_SET_RVA  0x900920ull
#define EXP_GETLEN   5
#define EXP_SETLEN   8

static const uint8_t EXP_GET_ORIG[EXP_GETLEN]  = { 0xF3, 0x0F, 0x10, 0x41, 0x58 };
static const uint8_t EXP_GET_PATCH[EXP_GETLEN] = { 0x0F, 0x57, 0xC0, 0xC3, 0x58 };
static const uint8_t EXP_SET_ORIG[EXP_SETLEN]  = { 0xF3, 0x0F, 0x11, 0x49, 0x58, 0xC3, 0xCC, 0xCC };
static const uint8_t EXP_SET_PATCH[EXP_SETLEN] = { 0xC7, 0x41, 0x58, 0x00, 0x00, 0x00, 0x00, 0xC3 };

#define EXP_DLY1_RVA 0xA5D5C4ull
#define EXP_DLY2_RVA 0xA5E722ull
#define EXP_DLY3_RVA 0xA5E754ull

static const uint8_t EXP_DLY1_ORIG[8]  = { 0xF3, 0x0F, 0x5F, 0x83, 0xA0, 0x00, 0x00, 0x00 };
static const uint8_t EXP_DLY1_PATCH[8] = { 0x0F, 0x57, 0xC0, 0x90, 0x90, 0x90, 0x90, 0x90 };
static const uint8_t EXP_DLY2_ORIG[5]  = { 0xF3, 0x0F, 0x5F, 0x53, 0x38 };
static const uint8_t EXP_DLY2_PATCH[5] = { 0x0F, 0x57, 0xD2, 0x90, 0x90 };
static const uint8_t EXP_DLY3_ORIG[5]  = { 0xF3, 0x0F, 0x5F, 0x53, 0x3C };
static const uint8_t EXP_DLY3_PATCH[5] = { 0x0F, 0x57, 0xD2, 0x90, 0x90 };

static volatile LONG g_patched;

static int patch_site(uint64_t a, const uint8_t* orig, const uint8_t* pat, int len, const char* tag) {
    uint8_t cur[8], chk[8];
    if (!rr_read(a, cur, len)) { elog("%s read fail %llx", tag, (unsigned long long)a); return 0; }
    if (!memcmp(cur, pat, len)) { elog("%s already patched", tag); return 1; }
    if (memcmp(cur, orig, len)) { elog("%s bytes unexpected %llx", tag, (unsigned long long)a); return 0; }
    if (!rr_write(a, pat, len)) { elog("%s write refused %llx", tag, (unsigned long long)a); return 0; }
    if (!rr_read(a, chk, len) || memcmp(chk, pat, len)) {
        elog("%s verify fail %llx", tag, (unsigned long long)a);
        rr_write(a, orig, len);
        return 0;
    }
    elog("%s ok %llx", tag, (unsigned long long)a);
    return 1;
}

static int exp_patch(void) {
    uint64_t mod = 0;
    uint32_t sz = 0;
    int a, b, c, d, e;
    if (g_patched) return 1;
    if (!rr_module("GameAssembly.dll", &mod, &sz) || !mod) { elog("module missing"); return 0; }
    elog("module=%llx size=%X", (unsigned long long)mod, sz);
    a = patch_site(mod + EXP_GET_RVA, EXP_GET_ORIG, EXP_GET_PATCH, EXP_GETLEN, "get");
    b = patch_site(mod + EXP_SET_RVA, EXP_SET_ORIG, EXP_SET_PATCH, EXP_SETLEN, "set");
    c = patch_site(mod + EXP_DLY1_RVA, EXP_DLY1_ORIG, EXP_DLY1_PATCH, 8, "dly1");
    d = patch_site(mod + EXP_DLY2_RVA, EXP_DLY2_ORIG, EXP_DLY2_PATCH, 5, "dly2");
    e = patch_site(mod + EXP_DLY3_RVA, EXP_DLY3_ORIG, EXP_DLY3_PATCH, 5, "dly3");
    if (!a || !b || !c || !d || !e) { if (a || b || c || d || e) g_patched = 1; return 0; }
    g_patched = 1;
    return 1;
}

static void exp_unpatch(void) {
    uint64_t mod = 0;
    uint32_t sz = 0;
    if (!g_patched) return;
    if (!rr_module("GameAssembly.dll", &mod, &sz) || !mod) { elog("unpatch module missing"); g_patched = 0; return; }
    if (rr_write(mod + EXP_GET_RVA, EXP_GET_ORIG, EXP_GETLEN)) elog("unpatched get"); else elog("unpatch get fail");
    if (rr_write(mod + EXP_SET_RVA, EXP_SET_ORIG, EXP_SETLEN)) elog("unpatched set"); else elog("unpatch set fail");
    if (rr_write(mod + EXP_DLY1_RVA, EXP_DLY1_ORIG, 8)) elog("unpatched dly1"); else elog("unpatch dly1 fail");
    if (rr_write(mod + EXP_DLY2_RVA, EXP_DLY2_ORIG, 5)) elog("unpatched dly2"); else elog("unpatch dly2 fail");
    if (rr_write(mod + EXP_DLY3_RVA, EXP_DLY3_ORIG, 5)) elog("unpatched dly3"); else elog("unpatch dly3 fail");
    g_patched = 0;
}

static int klass_valid(void) {
    return g_klass && name_ok(g_klass);
}

static int resolve_class_walk(void) {
    int r;
    if (klass_valid()) return 1;
    g_klass = 0;
    g_klass_tmp = 0;
    g_nhit = 0;
    g_budget = 400000;
    r = walk(1, 1, 1, cb_lit);
    if (!g_nhit) return 0;
    g_budget = 60000;
    r = walk_writable(cb_ptr);
    if (g_klass_tmp) { g_klass = g_klass_tmp; return 1; }
    return 0;
}

static int resolve_instances_walk(void) {
    int r;
    if (!resolve_class_walk()) { elog("no inst"); return 0; }
    if (!g_cur) g_ninst = 0;
    g_budget = 60000;
    r = walk_writable(cb_inst);
    if (g_ninst > 0) { g_cur = 0; return hold(); }
    if (r == 0) elog("no inst");
    return 0;
}

static const char CHAIN_NAME[] = "BattleEntitiesUpdater";
static uint64_t g_chain_klass, g_chain_updater;
static uint64_t g_chain_hits[8];
static int g_chain_nhit;

static int chain_name_ok(uint64_t klass) {
    uint64_t np;
    char nm[sizeof(CHAIN_NAME)];
    memset(nm, 0, sizeof nm);
    if (!rr_read(klass + 0x10, &np, 8) || !p_qw(np)) return 0;
    return rr_read(np, nm, sizeof(nm) - 1) && !strcmp(nm, CHAIN_NAME);
}

static int chain_lit(uint64_t base, const uint8_t* p, unsigned len) {
    unsigned o, n = (unsigned)sizeof(CHAIN_NAME) - 1;
    for (o = 0; o + n < len; o++) {
        if (memcmp(p + o, CHAIN_NAME, n) || p[o + n]) continue;
        if (g_chain_nhit < 8) g_chain_hits[g_chain_nhit++] = base + o;
        if (g_chain_nhit >= 8) return 1;
    }
    return 0;
}

static int chain_ptr(uint64_t base, const uint8_t* p, unsigned len) {
    unsigned o;
    int i;
    for (o = 0; o + 8 <= len; o += 8) {
        uint64_t v, cand;
        memcpy(&v, p + o, 8);
        for (i = 0; i < g_chain_nhit; i++) {
            if (v != g_chain_hits[i] || base + o < 0x10) continue;
            cand = base + o - 0x10;
            if (!chain_name_ok(cand)) continue;
            g_chain_klass = cand;
            return 1;
        }
    }
    return 0;
}

static int chain_collect(uint64_t updater) {
    uint64_t content, list, entries;
    int32_t count, i;
    content = rr_u64(updater + 0x68);
    if (!p_qw(content)) return 0;
    list = rr_u64(content + 0x540);
    if (!p_qw(list)) return 0;
    entries = rr_u64(list + 0x18);
    if (!p_qw(entries) || !rr_read(list + 0x20, &count, 4) || count <= 0 || count > 4096) return 0;
    g_ninst = 0;
    for (i = 0; i < count && g_ninst < EXP_MAX_INST; i++) {
        uint64_t desc;
        float v;
        desc = rr_u64(entries + (uint64_t)i * 0x18 + 0x10);
        if (!p_qw(desc) || !rr_read(desc + EXP_OFF, &v, 4)) continue;
        if (!(v >= 0.0f && v < 60.0f)) continue;
        g_inst[g_ninst] = desc;
        g_orig[g_ninst] = v;
        elog("INST %llx val=%f", (unsigned long long)desc, (double)v);
        g_ninst++;
    }
    return g_ninst > 0;
}

static int chain_inst(uint64_t base, const uint8_t* p, unsigned len) {
    unsigned o;
    for (o = 0; o + 8 <= len; o += 8) {
        uint64_t v;
        memcpy(&v, p + o, 8);
        if (v != g_chain_klass || !chain_collect(base + o)) continue;
        g_chain_updater = base + o;
        return 1;
    }
    return 0;
}

static int resolve_chain(void) {
    g_ninst = 0;
    g_chain_updater = 0;
    if (!g_chain_klass || !chain_name_ok(g_chain_klass)) {
        g_chain_klass = 0;
        g_chain_nhit = 0;
        g_cur = 0;
        g_budget = 400000;
        walk(1, 1, 1, chain_lit);
        if (!g_chain_nhit) return 0;
        g_cur = 0;
        g_budget = 60000;
        walk_writable(chain_ptr);
        if (!g_chain_klass) return 0;
    }
    g_cur = 0;
    g_budget = 60000;
    walk_writable(chain_inst);
    return g_ninst > 0;
}

static int resolve(void) {
    if (!exp_patch()) return 0;
    if (resolve_chain()) return 1;
    return resolve_instances_walk();
}

static int hold(void) {
    static const float z = 0.0001f;
    int i;
    for (i = 0; i < g_ninst; i++) {
        float chk;
        uint64_t a = g_inst[i] + EXP_OFF;
        if (!rr_read(a, &chk, 4)) { g_ready = 0; return 0; }
        if (chk == z) continue;
        if (!rr_write(a, &z, 4) || !rr_read(a, &chk, 4) || chk != z) { g_ready = 0; return 0; }
        elog("zeroed %llx", (unsigned long long)g_inst[i]);
    }
    return 1;
}

static void restore(void) {
    int i;
    for (i = 0; i < g_ninst; i++) {
        if (rr_write(g_inst[i] + EXP_OFF, &g_orig[i], 4))
            elog("restored %llx", (unsigned long long)g_inst[i]);
    }
    g_ninst = 0;
}

static DWORD WINAPI exp_thread(void* p) {
    DWORD last_try = 0;
    elog("thread start off=%d size=%d", (int)((char*)&((BR_Config*)0)->exp_fast_scan - (char*)0), (int)sizeof(BR_Config));
    int held = 0;
    (void)p;
    for (;;) {
        if (!g_enabled) {
            if (held || g_ninst) { restore(); held = 0; }
            if (g_patched) { exp_unpatch(); g_ready = 0; } g_stage = 0; g_cur = 0; g_nhit = 0; g_dom_done = 0;
            Sleep(40);
            continue;
        }
        if (!g_ready) {
            DWORD now = GetTickCount();
            if (g_arm && now >= g_arm && now - last_try > 3000) {
                last_try = now;
                if (held) { restore(); held = 0; }
            if (g_patched) { exp_unpatch(); g_ready = 0; }
                if (resolve()) g_ready = 1;
            }
            Sleep(50);
            continue;
        }
        hold();
        held = 1;
        Sleep(500);
    }
}

void exp_tick(void) {
    {
        static int once = 0, tick = 0;
        LONG w = br_get()->exp_fast_scan ? 1 : 0;
        if (!once) { once = 1; g_arm = GetTickCount() + 45000; elog("tick alive"); }
        if (w != g_enabled) { elog("enabled=%ld", w); if (w) g_arm = GetTickCount() + 2000; }
        if ((++tick % 600) == 0) elog("still alive w=%ld", w);
        g_enabled = w;
    }
    if (!g_started && InterlockedExchange(&g_started, 1) == 0)
        CreateThread(NULL, 0, exp_thread, NULL, 0, NULL);
}
